  "causal_diagnosis_framework": {
    "purpose": "让模型不要只改写原话，而是先还原业务现场、识别流程断点、判断被动后果，再生成需求。",
    "steps": [
      {
        "name": "业务对象",
        "instruction": "识别这句话里的核心业务对象，例如工单、物料、采购订单、供应商交期、质量异常、整改任务、服务单、库存、客户订单、合同、权限申请。"
      },
      {
        "name": "当前人工做法",
        "instruction": "判断现在业务人员靠什么处理，必须具体，例如人工去问车间、人工催供应商、会议前临时查、Excel手工汇总、群里确认、人工导出比对、靠人记住。"
      },
      {
        "name": "流程断点",
        "instruction": "判断业务链路断在哪里，必须具体，例如状态没有同步、责任人不清、超期没有提醒、数据分散在多个系统、异常登记后没有关闭跟踪、跨部门信息不同步。"
      },
      {
        "name": "被动后果",
        "instruction": "判断为什么业务人员会痛，例如等别人来问才发现、客户催才查、开会才想起来、月底才集中处理、生产已经受影响后才发现。"
      },
      {
        "name": "真实诉求",
        "instruction": "用户不是单纯想要一个功能，而是希望系统帮助某个角色提前发现、跟进或闭环某个问题，避免某个业务后果。"
      },
      {
        "name": "最小系统动作",
        "instruction": "判断系统最小应该替代哪一步人工动作，例如自动识别异常、自动形成待办、自动提醒责任人、自动同步状态、自动展示进度、自动跟踪关闭、自动汇总差异。"
      },
      {
        "name": "待确认边界",
        "instruction": "不确定的系统、规则、提醒对象、触发时点、关闭标准都放到 uncertain_items，不要把推测当成事实。"
      }
    ]
  },
